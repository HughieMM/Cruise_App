rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidString(value, maxLength) {
      return value is string && value.size() <= maxLength;
    }

    function isValidTimestamp(value) {
      return value is timestamp;
    }

    // ==================== Users Collection ====================
    match /users/{userId} {
      // Anyone authenticated can read any profile — the app already
      // assumes this everywhere (pod chat mini-profiles, tribe member
      // lists, the tribe-matching algorithm reading candidates), same
      // trust level as every other same-sailing collection below.
      allow read: if isAuthenticated();

      // Users can create their own document
      allow create: if isAuthenticated() && isOwner(userId)
        && request.resource.data.keys().hasAll(['uid', 'email', 'name', 'ageBand'])
        && isValidString(request.resource.data.name, 50)
        && isValidString(request.resource.data.ageBand, 10)
        && request.resource.data.ageBand in ['16-17', '18-20', '21-30', '31-39', '39+'];

      // Users can update their own document (except uid and email). Any
      // authenticated user can additionally set ONLY currentTribeId —
      // the tribe-matching run assigns tribes to every matched user, not
      // just whoever's client happened to trigger it, and there's no way
      // for rules alone to verify "this write came from a legitimate
      // matching run." Kept as narrow as possible: nothing else on
      // another user's doc is writable this way.
      allow update: if isAuthenticated()
        && (
          (isOwner(userId)
           && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['uid', 'email']))
          ||
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['currentTribeId', 'updatedAt'])
        );

      // Users can delete their own document
      allow delete: if isAuthenticated() && isOwner(userId);

      // ==================== Badges Subcollection ====================
      // Always read/written for the CALLING user's own uid only (badge
      // progress is never viewed for other users), so this can stay
      // fully owner-locked.
      match /badges/{badgeId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId);
        allow update, delete: if false;
      }

      // ==================== Stats Subcollection (badge progress) ====================
      match /stats/{statDoc} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId);
        allow delete: if false;
      }

      // ==================== Blocked Users Subcollection ====================
      // Always read/written for the CALLING user's own uid only.
      match /blockedUsers/{blockedUserId} {
        allow read: if isOwner(userId);
        allow create, delete: if isOwner(userId);
        allow update: if false;
      }
    }

    // ==================== Reports Collection ====================
    // Content/user reports — the reporter can read their own history
    // (hasUserReported/getReportCount queries), moderation happens from
    // the Firebase console for now (no admin app yet).
    match /reports/{reportId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.contentType in ['user', 'photo', 'message', 'profile']
        && isValidString(request.resource.data.reason, 200);
      // Only the 'status' field ever changes, when a photo auto-actions
      // after 2+ reports.
      allow update: if isAuthenticated()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
      allow delete: if false;
    }

    // ==================== Feedback Collection ====================
    // Bug reports and feature suggestions — write-only for users, only
    // readable/manageable from the Firebase console (no admin app yet).
    match /feedback/{feedbackId} {
      allow read: if false;
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.type in ['bug', 'feature']
        && isValidString(request.resource.data.message, 1000);
      allow update, delete: if false;
    }

    // ==================== Sailings Collection ====================
    match /sailings/{sailingId} {
      // Anyone authenticated can read sailings
      allow read: if isAuthenticated();

      // The onboarding flow self-serve creates a sailing the first time
      // someone picks a cruise/ship/date combo that doesn't exist yet
      // (FirestoreService.findOrCreateSailing), so creation has to stay
      // open — but validate the shape so a client can't inject garbage.
      // Nothing ever updates a sailing after creation, so that stays
      // denied. Revisit with custom claims if an admin panel is built.
      allow create: if isAuthenticated()
        && request.resource.data.keys().hasAll(
            ['shipId', 'cruiseLineId', 'departureDate', 'returnDate', 'memberCount', 'active', 'createdAt'])
        && isValidString(request.resource.data.shipId, 100)
        && isValidString(request.resource.data.cruiseLineId, 100)
        && isValidTimestamp(request.resource.data.departureDate)
        && request.resource.data.memberCount == 0
        && request.resource.data.active == true;
      // The one exception to "nothing updates a sailing": the tribe-
      // matching trigger lock (see tribes below) flips this single field.
      allow update: if isAuthenticated()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tribeMatchingStatus'])
        && request.resource.data.tribeMatchingStatus in ['not_started', 'in_progress', 'completed'];
      allow delete: if false;

      // ==================== Pods Subcollection ====================
      match /pods/{podId} {
        // Anyone on the sailing can read pods
        allow read: if isAuthenticated();

        // The app auto-seeds the default pods for a sailing from the
        // client the first time anyone opens Pods, so creation has to
        // stay open to authenticated users — but validate the shape so
        // a client can't inject arbitrary pod data.
        allow create: if isAuthenticated()
          && request.resource.data.sailingId == sailingId
          && isValidString(request.resource.data.name, 50)
          && request.resource.data.memberCount == 0
          && request.resource.data.ageBucket in ['teen', 'young_adult', 'adult'];

        // Only memberCount/lastMessageAt ever change after creation —
        // name/color/icon/ageBucket are fixed once a pod is seeded.
        allow update: if isAuthenticated()
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['memberCount', 'lastMessageAt']);

        allow delete: if false;

        // ==================== Pod Members Subcollection ====================
        match /members/{userId} {
          // Anyone on the sailing can read members
          allow read: if isAuthenticated();

          // Users can join/leave pods (create/delete their membership)
          allow create: if isAuthenticated() && isOwner(userId);
          allow delete: if isAuthenticated() && isOwner(userId);
          allow update: if false; // No updates to membership
        }

        // ==================== Messages Subcollection ====================
        match /messages/{messageId} {
          // Anyone in the pod can read messages
          allow read: if isAuthenticated();

          // Users can create messages if they're in the pod
          allow create: if isAuthenticated()
            && request.resource.data.userId == request.auth.uid
            && isValidString(request.resource.data.text, 500)
            && isValidTimestamp(request.resource.data.timestamp);

          // Users can delete their own messages
          allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;

          // No updates to messages
          allow update: if false;
        }
      }

      // ==================== Cruise Memories Subcollection ====================
      match /memories/{memoryId} {
        // Anyone on the sailing can read (shown on the shared Memories screen)
        allow read: if isAuthenticated();

        allow create: if isAuthenticated()
          && request.resource.data.userId == request.auth.uid
          && isValidTimestamp(request.resource.data.createdAt);

        allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
        allow update: if false;
      }

      // ==================== Hangouts Subcollection ====================
      match /hangouts/{hangoutId} {
        // Anyone on the sailing can read hangouts
        allow read: if isAuthenticated();

        // Users can create hangouts
        allow create: if isAuthenticated()
          && request.resource.data.createdBy == request.auth.uid
          && isValidString(request.resource.data.location, 100)
          && request.resource.data.vibe in ['chill', 'lively', 'party']
          && isValidTimestamp(request.resource.data.startTime)
          && isValidTimestamp(request.resource.data.expiresAt);

        // Users can join/leave hangouts (update attendeeIds)
        allow update: if isAuthenticated()
          && (
            // Adding self to attendeeIds
            (request.resource.data.attendeeIds.hasAll([request.auth.uid])
             && !resource.data.attendeeIds.hasAll([request.auth.uid]))
            ||
            // Removing self from attendeeIds
            (!request.resource.data.attendeeIds.hasAll([request.auth.uid])
             && resource.data.attendeeIds.hasAll([request.auth.uid]))
            ||
            // Creator deactivating expired hangout
            (request.resource.data.active == false
             && resource.data.createdBy == request.auth.uid)
            ||
            // Photo count bumped by addHangoutPhoto/deleteHangoutPhoto
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['photoCount'])
          );

        // No deletion of hangouts
        allow delete: if false;

        // ==================== Hangout Photos Subcollection ====================
        match /photos/{photoId} {
          // Anyone on the sailing can read hangout photos
          allow read: if isAuthenticated();

          allow create: if isAuthenticated()
            && request.resource.data.userId == request.auth.uid
            && isValidString(request.resource.data.userName, 50)
            && isValidString(request.resource.data.photoUrl, 500)
            && isValidTimestamp(request.resource.data.takenAt);

          // Any authenticated user (not just the poster) so the
          // auto-delete-after-2-reports moderation flow can clean up the
          // doc — it runs from whichever client submits the triggering
          // report, not the original poster. Same trust level already
          // granted to reports.status updates and tribe member writes
          // elsewhere in this file (no admin backend exists yet).
          allow delete: if isAuthenticated();
          allow update: if false;
        }
      }

      // ==================== Hot Zone Votes Subcollection ====================
      match /hotZoneVotes/{voteId} {
        // Anyone on the sailing can read votes (for aggregation)
        allow read: if isAuthenticated();

        // Users can create votes
        allow create: if isAuthenticated()
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.location in ['Main Pool', 'Casino', 'Nightclub', 'Sports Deck', 'Slides', 'Game Show', '18+ Pool']
          && request.resource.data.vibe in ['active', 'quiet', 'overcrowded', 'good_vibes']
          && isValidTimestamp(request.resource.data.timestamp)
          && isValidTimestamp(request.resource.data.expiresAt);

        // No updates or deletions (votes are immutable)
        allow update, delete: if false;
      }

      // ==================== Tribes Subcollection ====================
      match /tribes/{tribeId} {
        // Anyone on the sailing can read tribes
        allow read: if isAuthenticated();

        // Created by whichever client's tribe-matching run creates it —
        // not tied to a single uid, so no owner check makes sense here.
        allow create: if isAuthenticated()
          && request.resource.data.sailingId == sailingId
          && request.resource.data.memberIds == [];

        // Only these fields ever change after creation, as members are
        // added during matching.
        allow update: if isAuthenticated()
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['memberIds', 'isFull', 'lastActivityAt']);

        allow delete: if false;

        // ==================== Tribe Members Subcollection ====================
        match /members/{userId} {
          // Anyone on the sailing can read tribe members
          allow read: if isAuthenticated();

          // Written by whichever client runs matching for every member
          // being placed, not just the caller's own membership — same
          // trade-off as the tribes doc above. Tribe member data is the
          // same info (name/age/interests/photo) already visible via
          // pods and profiles.
          allow create: if isAuthenticated();
          allow update, delete: if false;
        }

        // ==================== Tribe Messages Subcollection ====================
        match /messages/{messageId} {
          // Anyone on the sailing can read (mirrors pod messages)
          allow read: if isAuthenticated();

          allow create: if isAuthenticated()
            && request.resource.data.userId == request.auth.uid
            && isValidString(request.resource.data.text, 500)
            && isValidTimestamp(request.resource.data.timestamp);

          allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
          allow update: if false;
        }
      }

      // ==================== Sibling Requests Subcollection ====================
      match /siblingRequests/{requestId} {
        // Anyone on the sailing can read (needed to look up pending
        // requests by target email)
        allow read: if isAuthenticated();

        allow create: if isAuthenticated()
          && request.resource.data.requesterId == request.auth.uid
          && request.resource.data.status == 'pending';

        // Covers accept/decline (by the target) and the matching run
        // marking accepted requests as 'matched'.
        allow update: if isAuthenticated()
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['targetId', 'targetName', 'status', 'respondedAt']);

        allow delete: if false;
      }

      // ==================== Sea Ya Photos Subcollection ====================
      match /seaYaPhotos/{photoId} {
        // Anyone on the sailing can read (tribe-only visibility is
        // enforced by only querying within a known tribeId, not by rules)
        allow read: if isAuthenticated();

        allow create: if isAuthenticated()
          && request.resource.data.userId == request.auth.uid
          && isValidString(request.resource.data.photoUrl, 500);

        allow update, delete: if false;
      }

      // ==================== Connection (First Mates) Requests ====================
      // Pod-only connect requests — mirrors siblingRequests' shape, but the
      // target's UID is already known at create time (connecting to a
      // specific person whose profile is already open), so nothing needs
      // filling in later beyond status/respondedAt.
      match /connectionRequests/{requestId} {
        allow read: if isAuthenticated();

        allow create: if isAuthenticated()
          && request.resource.data.requesterId == request.auth.uid
          && request.resource.data.status == 'pending';

        allow update: if isAuthenticated()
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'respondedAt']);

        allow delete: if false;
      }
    }

    // ==================== Direct Messages (First Mates) ====================
    // Not sailing-scoped — a connection should keep working after the cruise
    // ends. The only collection in this file that isn't trusted to "anyone
    // authenticated on the sailing": real per-thread privacy via
    // participantIds, checked with get() for the nested messages subcollection
    // since request.resource on a create there has no participantIds of its
    // own to check directly.
    match /directMessages/{threadId} {
      allow read: if isAuthenticated() && request.auth.uid in resource.data.participantIds;

      allow create: if isAuthenticated()
        && request.auth.uid in request.resource.data.participantIds
        && request.resource.data.participantIds.size() == 2;

      // Only lastMessageAt ever changes after creation.
      allow update: if isAuthenticated()
        && request.auth.uid in resource.data.participantIds
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessageAt']);

      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isAuthenticated()
          && request.auth.uid in get(/databases/$(database)/documents/directMessages/$(threadId)).data.participantIds;

        allow create: if isAuthenticated()
          && request.auth.uid in get(/databases/$(database)/documents/directMessages/$(threadId)).data.participantIds
          && request.resource.data.userId == request.auth.uid
          && isValidString(request.resource.data.text, 500)
          && isValidTimestamp(request.resource.data.timestamp);

        allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
        allow update: if false;
      }
    }
  }
}
