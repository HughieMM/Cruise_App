rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Profile photos: anyone signed in can view (needed for pod/tribe
    // members to see each other's photos), only the owner can write.
    match /users/{userId}/photos/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Sea Ya (daily photo) — tribe-only feature, same read/write pattern.
    match /sailings/{sailingId}/sea_ya_photos/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Cruise memory photos.
    match /sailings/{sailingId}/memories/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Hangout photos — any authenticated attendee can post/view.
    match /sailings/{sailingId}/hangouts/{hangoutId}/photos/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
